# ============================================================
#  Taza Ideal - plantilla de configuracion
#  Copia este archivo como "application.properties" (misma carpeta)
#  y llena los valores. application.properties NO se sube a GitHub.
# ============================================================

spring.application.name=tazaideal
server.port=8080

# --- Base de datos (MySQL de XAMPP en local) ---
spring.datasource.url=jdbc:mysql://localhost:3306/tazaideal?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=
spring.datasource.password=

# --- JPA: el esquema lo crea Flyway; JPA solo lo valida ---
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.jdbc.time_zone=UTC

# --- Flyway (migraciones en src/main/resources/db/migration) ---
spring.flyway.enabled=true

# --- JWT ---
app.jwt.secreto=
app.jwt.expiracion-minutos=120

# --- Correo (en el VPS: Postfix en localhost:25 reenvia por el SMTP del dominio) ---
# En local dejar app.mail.habilitado=false: los correos solo se escriben en el log
app.mail.habilitado=false
spring.mail.host=localhost
spring.mail.port=25
app.mail.remitente=Taza Ideal <no-reply@tazaideal.online>

# --- Twilio (SMS y WhatsApp). En local: habilitado=false (solo log) ---
app.twilio.habilitado=false
app.twilio.account-sid=
app.twilio.auth-token=
app.twilio.numero-sms=
# Sandbox de WhatsApp de Twilio (o tu numero aprobado), con el prefijo whatsapp:
app.twilio.numero-whatsapp=whatsapp:+14155238886
# Telefonos guardados con 10 digitos se envian como +52XXXXXXXXXX
app.twilio.prefijo-pais=+52

# --- Fotos de productos ---
app.uploads.dir=uploads
spring.servlet.multipart.max-file-size=2MB
spring.servlet.multipart.max-request-size=3MB

# --- Paginacion: maximo de elementos por pagina ---
spring.data.web.pageable.max-page-size=50

# --- CORS (frontend de Vite en local) ---
app.cors.origenes=http://localhost:5173

# --- URL del frontend (para el enlace de recuperar contrasena) ---
app.frontend.url=http://localhost:5173
