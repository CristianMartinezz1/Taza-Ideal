```mermaid
erDiagram
    roles ||--o{ usuarios : "tiene"
    categorias ||--o{ productos : "agrupa"
    productos ||--o{ producto_etiquetas : "tiene"
    etiquetas ||--o{ producto_etiquetas : "describe"
    usuarios ||--o{ pedidos : "realiza"
    pedidos ||--o{ detalle_pedido : "contiene"
    productos ||--o{ detalle_pedido : "aparece en"
    usuarios ||--o{ resultados_encuesta : "responde"
    productos ||--o{ resultados_encuesta : "es recomendado en"
    usuarios ||--o{ tokens_recuperacion : "solicita"

    roles {
        int id PK
        string nombre "ADMIN, BARISTA, CLIENTE"
    }

    usuarios {
        int id PK
        string nombre
        string correo UK
        string password "hash BCrypt"
        string telefono
        string avatar
        boolean activo
        boolean correo_verificado
        string codigo_verificacion "cifrado"
        datetime codigo_expiracion
        int rol_id FK
    }

    categorias {
        int id PK
        string nombre "Espresso, Con leche, Frios, Filtrados, Panaderia, Granos"
        boolean activo
    }

    productos {
        int id PK
        string nombre
        string descripcion
        decimal precio "MXN"
        string imagen_url
        boolean disponible
        int categoria_id FK
    }

    etiquetas {
        int id PK
        string nombre "caliente, fria, dulce, intenso, con leche, sin leche, chocolate"
    }

    producto_etiquetas {
        int producto_id PK, FK
        int etiqueta_id PK, FK
    }

    pedidos {
        int id PK
        string codigo "TI-1001"
        int usuario_id FK
        string estado
        datetime hora_recogida
        string notas
        decimal total
        datetime creado_en
    }

    detalle_pedido {
        int id PK
        int pedido_id FK
        int producto_id FK
        int cantidad
        decimal precio_unitario
        string tamano
        string leche
    }

    resultados_encuesta {
        int id PK
        int usuario_id FK
        int producto_recomendado_id FK
        json respuestas
        decimal porcentaje_coincidencia
        datetime creado_en
    }

    tokens_revocados {
        int id PK
        string jti UK
        datetime expiracion
    }

    tokens_recuperacion {
        int id PK
        string token UK
        int usuario_id FK
        datetime expiracion
        boolean usado
    }
```
