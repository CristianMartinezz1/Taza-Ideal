# ============================================================
#  Taza Ideal - configuracion de PRODUCCION (VPS)
#  Copiar a /opt/taza-ideal/application.properties y llenar los valores vacios.
#  Ese archivo NO se sube a GitHub (tiene contrasenas y tokens) y el JAR
#  no trae ninguna configuracion con secretos: todo sale de aqui.
# ============================================================

spring.application.name=tazaideal

# --- Base de datos (creada con deploy/crear_base_vps.sql) ---
spring.datasource.url=jdbc:mysql://localhost:3306/taza_ideal?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=taza_ideal_app
spring.datasource.password=

# --- JPA: el esquema lo crea Flyway; JPA solo lo valida ---
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.jdbc.time_zone=UTC
spring.flyway.enabled=true

# --- JWT: generar con  openssl rand -base64 48 ---
app.jwt.secreto=
app.jwt.expiracion-minutos=120

# --- Correo real por Postfix (localhost:25 reenvia por el SMTP del dominio) ---
app.mail.habilitado=true
spring.mail.host=localhost
spring.mail.port=25
app.mail.remitente=Taza Ideal <no-reply@tazaideal.online>

# --- Twilio: SMS y WhatsApp reales (regenerar el Auth Token en la consola de Twilio) ---
app.twilio.habilitado=true
app.twilio.account-sid=
app.twilio.auth-token=
app.twilio.numero-sms=
app.twilio.numero-whatsapp=whatsapp:+14155238886
app.twilio.prefijo-pais=+52

# --- Fotos de productos ---
app.uploads.dir=/opt/taza-ideal/uploads
spring.servlet.multipart.max-file-size=2MB
spring.servlet.multipart.max-request-size=3MB

# --- Paginacion ---
spring.data.web.pageable.max-page-size=50

# --- Frontend publicado y CORS ---
app.frontend.url=https://tazaideal.online
app.cors.origenes=https://tazaideal.online,https://www.tazaideal.online

# --- Errores: nunca mostrar trazas al usuario ---
server.error.include-stacktrace=never
server.error.include-message=never
